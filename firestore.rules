rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && request.auth.token.email == "khellermann@gmail.com";
    }

    match /profiles/{userId} {
      allow create: if signedIn() && request.auth.uid == userId;
      allow read: if signedIn() && (request.auth.uid == userId || admin());
      allow update, delete: if admin();
    }

    match /visitantes/{id} {
      allow create: if true;
      allow read, update: if signedIn();
      allow delete: if admin();
    }

    match /pesquisas_satisfacao/{id} {
      allow create: if true;
      allow read: if signedIn();
      allow update, delete: if admin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /registration_opportunities/{opportunityId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /registrations/{registrationId} {
      allow create: if true;
      allow read, update, delete: if admin();
    }

    match /admin_users/{email} {
      allow read: if admin();
      allow create, update, delete: if admin();
    }

    match /site_settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }
  }
}
