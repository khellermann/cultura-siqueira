rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function normalizedEmail() {
      return lower(request.auth.token.email);
    }

    function isPrimaryAdmin() {
      return signedIn() && normalizedEmail() == "khellermann@gmail.com";
    }

    function isAdmin() {
      return isPrimaryAdmin()
        || (signedIn() && exists(/databases/$(database)/documents/admin_users/$(normalizedEmail())));
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /admin_users/{email} {
      allow read: if isAdmin();
      allow create, update, delete: if isPrimaryAdmin();
    }
  }
}
