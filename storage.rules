rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function normalizedEmail() {
      return lower(request.auth.token.email);
    }

    function isPrimaryAdmin() {
      return signedIn() && normalizedEmail() == "khellermann@gmail.com";
    }

    function isAdmin() {
      return isPrimaryAdmin()
        || (signedIn()
          && firestore.exists(/databases/(default)/documents/admin_users/$(normalizedEmail())));
    }

    match /eventos/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
